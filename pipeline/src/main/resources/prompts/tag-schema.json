{
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "cities", "workMode", "jobType", "fresherFit", "expMinYears", "expMaxYears",
               "stipendMinInr", "stipendMaxInr", "skills", "confidence"],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["Software Engineering", "Data & Analytics", "AI/ML", "Product Management", "Design",
               "Marketing", "Sales & Business Development", "Operations", "Finance & Accounting",
               "HR & Recruiting", "Content & Media", "Customer Support", "Consulting & Strategy", "Other"]
    },
    "cities": {
      "type": "array",
      "description": "Canonical Indian city names where the job is based, \"Remote\", or [\"India (unspecified)\"] if no city is stated.",
      "items": { "type": "string" }
    },
    "workMode": { "type": "string", "enum": ["onsite", "hybrid", "remote", "unknown"] },
    "jobType": { "type": "string", "enum": ["internship", "full_time", "unknown"] },
    "fresherFit": { "type": "string", "enum": ["yes", "no", "unclear"] },
    "expMinYears": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
    "expMaxYears": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
    "stipendMinInr": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
    "stipendMaxInr": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
    "skills": {
      "type": "array",
      "description": "Up to 5 concrete skills or tools named in the post.",
      "items": { "type": "string" }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  }
}
