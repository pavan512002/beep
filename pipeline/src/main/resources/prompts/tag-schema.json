{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inIndia",
    "role",
    "cities",
    "workMode",
    "jobType",
    "fresherFit",
    "expMinYears",
    "expMaxYears",
    "stipendMinInr",
    "stipendMaxInr",
    "skills",
    "impliedSkills",
    "confidence"
  ],
  "properties": {
    "inIndia": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unclear"
      ],
      "description": "Is the job based in India (or remote for an Indian employer)?"
    },
    "role": {
      "type": "string",
      "enum": [
        "Software Engineering",
        "Data & Analytics",
        "AI/ML",
        "Product Management",
        "Design",
        "Marketing",
        "Sales & Business Development",
        "Operations",
        "Finance & Accounting",
        "HR & Recruiting",
        "Content & Media",
        "Customer Support",
        "Consulting & Strategy",
        "Other"
      ]
    },
    "cities": {
      "type": "array",
      "description": "Canonical Indian city names where the job is based, \"Remote\", or [\"India (unspecified)\"] if no city is stated.",
      "items": {
        "type": "string"
      }
    },
    "workMode": {
      "type": "string",
      "enum": [
        "onsite",
        "hybrid",
        "remote",
        "unknown"
      ]
    },
    "jobType": {
      "type": "string",
      "enum": [
        "internship",
        "full_time",
        "unknown"
      ]
    },
    "fresherFit": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unclear"
      ]
    },
    "expMinYears": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "expMaxYears": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "stipendMinInr": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "stipendMaxInr": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "skills": {
      "type": "array",
      "description": "Up to 6 skills the post names, using names from the allowed skill list in the instructions.",
      "items": {
        "type": "string"
      }
    },
    "impliedSkills": {
      "type": "array",
      "description": "Up to 4 skills the role clearly needs but the post doesn't name, from the allowed skill list.",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  }
}